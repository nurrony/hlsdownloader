{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["@clean-jsdoc-theme/typedoc"],
  "entryPoints": ["src/**/*.ts"],
  "entryPointStrategy": "expand",
  "exclude": ["src/index.ts"],
  "outputs": [{ "name": "clean-jsdoc-theme", "path": "docs" }],
  "cleanJsdocTheme": {
    "strict": true,
    "progress": false,
    "favicon": "./assets/favicon.svg",
    "siteName": "HLS Downloader",
    "sectionOrder": ["Getting Started", "Guides", "Classes", "Modules"],
    "defaultLocale": "en",
    "docs": "./docs",
    "menu": [
      { "title": "Home", "link": "/", "target": "_self", "icon": "lucide:home" },
      {
        "title": "GitHub",
        "target": "_blank",
        "link": "https://github.com/nurrony/hlsdownloader.git",
        "icon": "simpleicons:github"
      },
      {
        "title": "NPM",
        "target": "_blank",
        "link": "https://www.npmjs.com/package/hlsdownloader",
        "icon": "simpleicons:npm"
      },
      {
        "title": "Contribution Guide",
        "link": "https://github.com/nurrony/hlsdownloader/blob/main/CONTRIBUTING.md",
        "class": "simpleicons:contributorcovenant"
      }
    ],
    "locales": [
      { "code": "en", "name": "English" },
      { "code": "es", "name": "Española (próximamente)" }
    ],
    "meta": [
      {
        "content": "Nur Rony",
        "name": "Author"
      },
      {
        "content": "Downloads HLS Playlist file and TS chunks",
        "name": "Description"
      }
    ],
    "footer": "<style>span[role='img']{display: flex;justify-content: center;}span[role='img'] svg{display: block;}</style><div style='text-align: center;margin:10px auto;'>© 2026 HLS Downloader</div>"
  }
}
